# Copie para backend/.env e preencha. Este arquivo nunca vai para o git.

# Chave do Groq (https://console.groq.com/keys). Fica só no servidor.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Id do projeto Firebase (o mesmo de VITE_FIREBASE_PROJECT_ID no front)
FIREBASE_PROJECT_ID=

# Origens do front autorizadas, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Limites de uso (opcionais; estes são os padrões)
# RATE_LIMIT_PER_MINUTE=30
# DAILY_LIMIT=500
# DAILY_LIMIT_ANONYMOUS=100
# IP_RATE_LIMIT_PER_MINUTE=120
# MAX_HISTORY_MESSAGES=30

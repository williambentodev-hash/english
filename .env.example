# Copie para .env.local e preencha com os dados do app Web do seu projeto Firebase
# (Console do Firebase → Configurações do projeto → Seus apps → SDK setup and configuration).
# Sem API_KEY, AUTH_DOMAIN e PROJECT_ID o app funciona só com o localStorage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# URL do back-end (pasta backend/), ex.: http://localhost:8000
# Obrigatória para conversar com o tutor: a chave do LLM fica no servidor, que valida o login do Firebase acima.
VITE_API_URL=
